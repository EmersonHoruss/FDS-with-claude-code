{
  "name": "angular-feature-sliced",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:console": "ng test --watch=false --browsers=ChromeHeadless --reporters=spec",
    "lint": "eslint \"{src,server.ts}/**/*.{ts,html}\"",
    "lint:fix": "eslint \"{src,server.ts}/**/*.{ts,html}\" --fix",
    "format": "prettier \"src/**/*.{ts,html,css,scss}\" \"server.ts\" --write",
    "dev:ssr": "ng run angular-feature-sliced:serve-ssr",
    "serve:ssr": "node dist/angular-feature-sliced/server/main.js",
    "build:ssr": "ng build && ng run angular-feature-sliced:server",
    "prerender": "ng run angular-feature-sliced:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.6",
    "@angular/cdk": "16.2.6",
    "@angular/common": "^16.2.6",
    "@angular/compiler": "^16.2.6",
    "@angular/core": "^16.2.6",
    "@angular/forms": "^16.2.6",
    "@angular/material": "16.2.6",
    "@angular/platform-browser": "^16.2.6",
    "@angular/platform-browser-dynamic": "^16.2.6",
    "@angular/platform-server": "^16.2.6",
    "@angular/router": "^16.2.6",
    "@ngrx/effects": "^16.3.0",
    "@ngrx/entity": "^16.3.0",
    "@ngrx/router-store": "^16.3.0",
    "@ngrx/store": "^16.3.0",
    "@nguniversal/express-engine": "^16.2.0",
    "express": "^4.18.2",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.6",
    "@angular-eslint/builder": "^16.3.1",
    "@angular-eslint/eslint-plugin": "^16.3.1",
    "@angular-eslint/eslint-plugin-template": "^16.3.1",
    "@angular-eslint/schematics": "^16.3.1",
    "@angular-eslint/template-parser": "^16.3.1",
    "@angular/cli": "~16.2.3",
    "@angular/compiler-cli": "^16.2.6",
    "@feature-sliced/eslint-config": "^0.1.0-beta",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@ngrx/schematics": "^16.3.0",
    "@ngrx/store-devtools": "^16.3.0",
    "@nguniversal/builders": "^16.2.0",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.11.7",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.32.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "karma-spec-reporter": "^0.0.37",
    "prettier": "^3.6.2",
    "steiger": "^0.6.0",
    "typescript": "~5.1.6"
  }
}
